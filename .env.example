# Public browser values. A Supabase publishable key is safe to expose; never
# place a service-role key in NEXT_PUBLIC_* or commit it to the repository.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local SQLite development adapter.
LOVELOOM_LOCAL_ALPHA=1
# Set only in a local terminal when preparing your private owner invitation.
# LOVELOOM_ADMIN_SETUP_TOKEN=
